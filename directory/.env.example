# Variables consommées par `resolve_attestation` (src/main.rs) — la vérification d'attestation
# "serveur officiel" signée par le CMS (EdDSA), sans passage par ZITADEL/JWKS.

# Clé publique Ed25519 (SPKI PEM) de l'autorité d'attestation. Sa moitié privée vit dans le CMS
# (TESSERA_ATTESTATION_SIGNING_KEY, tessera-administration/website/cms/.env.example) — même paire
# obligatoire, sinon toute vérification échoue silencieusement (kind rétrogradé à community). Voir
# tessera-core/directory/ATTESTATION_KEYS.md pour la génération/rotation. Accepte les \n échappés
# (chaîne one-liner) — resolve_attestation fait `.replace("\\n", "\n")` avant usage.
TESSERA_ATTESTATION_PUBLIC_KEY=

# Endpoint interne du serveur qui relaie son JWT d'attestation courant. Réponse attendue :
# {"token": "<jwt>"}. Dans le compose serveur (tessera-core/server/docker-compose.yml), le
# gateway écoute sur TESSERA_INTERNAL_ATTESTATION_LISTEN=0.0.0.0:9090 (jamais publié via `ports:`,
# réseau Docker interne uniquement — même pattern que les métriques 9100) : `directory` (conteneur
# séparé) le joint par NOM DE SERVICE, pas loopback (127.0.0.1 serait le loopback de SON PROPRE
# conteneur, pas celui du gateway) — d'où `http://gateway:9090/...` ci-dessous, pas
# `http://tessera-server:9090` ni `http://localhost:9090`. Piège vécu (2026-07-17) : sans la
# variable côté gateway ET ce nom de service exact ici, `directory` ne joint jamais l'endpoint et
# aucun serveur n'est jamais republié "official" (échec silencieux, repli "community").
TESSERA_INTERNAL_ATTESTATION_URL=http://gateway:9090/internal/attestation

# Base URL du CMS, utilisée pour la confirmation de non-révocation
# (GET /api/public/official-server-by-slug?slug=...) après vérification de la signature du token.
TESSERA_CMS_URL=http://tessera-cms:3001
