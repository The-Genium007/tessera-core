# Variables consommées par `resolve_attestation` (src/main.rs) — la vérification d'attestation
# "serveur officiel" signée par le CMS (EdDSA), sans passage par ZITADEL/JWKS.

# Clé publique Ed25519 (SPKI PEM) de l'autorité d'attestation. Sa moitié privée vit dans le CMS
# (TESSERA_ATTESTATION_SIGNING_KEY, tessera-administration/website/cms/.env.example) — même paire
# obligatoire, sinon toute vérification échoue silencieusement (kind rétrogradé à community). Voir
# tessera-core/directory/ATTESTATION_KEYS.md pour la génération/rotation. Accepte les \n échappés
# (chaîne one-liner) — resolve_attestation fait `.replace("\\n", "\n")` avant usage.
TESSERA_ATTESTATION_PUBLIC_KEY=

# Endpoint interne du serveur qui relaie son JWT d'attestation courant (loopback/réseau interne
# uniquement — jamais exposé publiquement). Réponse attendue : {"token": "<jwt>"}.
TESSERA_INTERNAL_ATTESTATION_URL=http://tessera-server:9090/internal/attestation

# Base URL du CMS, utilisée pour la confirmation de non-révocation
# (GET /api/public/official-server-by-slug?slug=...) après vérification de la signature du token.
TESSERA_CMS_URL=http://tessera-cms:3001
